<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Главный экран — <%= content.site.name %> Админ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Montserrat', sans-serif; background: #f5f1ee; color: #333; min-height: 100vh; }

    .admin-layout { display: flex; min-height: 100vh; }

    .admin-sidebar {
      width: 260px;
      background: linear-gradient(180deg, #8FA86E 0%, #6E8A4F 100%);
      color: #fff; flex-shrink: 0; position: fixed;
      top: 0; left: 0; bottom: 0; overflow-y: auto; z-index: 100;
    }
    .admin-sidebar__brand { padding: 28px 24px 20px; border-bottom: 1px solid rgba(255,255,255,0.15); }
    .admin-sidebar__brand-name { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 600; display: block; }
    .admin-sidebar__brand-sub { font-size: 0.7rem; opacity: 0.7; text-transform: uppercase; letter-spacing: 1px; margin-top: 4px; display: block; }
    .admin-sidebar__nav { padding: 16px 0; }
    .admin-sidebar__link {
      display: flex; align-items: center; gap: 10px; padding: 12px 24px;
      color: rgba(255,255,255,0.85); text-decoration: none; font-size: 0.88rem;
      font-weight: 500; transition: all 0.2s; border-left: 3px solid transparent;
    }
    .admin-sidebar__link:hover { background: rgba(255,255,255,0.1); color: #fff; }
    .admin-sidebar__link--active { background: rgba(255,255,255,0.12); color: #fff; border-left-color: #fff; }
    .admin-sidebar__link--danger { color: rgba(255,200,200,0.8); }
    .admin-sidebar__link--danger:hover { color: #fcc; background: rgba(255,100,100,0.15); }
    .admin-sidebar__separator { height: 1px; background: rgba(255,255,255,0.12); margin: 8px 24px; }
    .admin-sidebar__link-icon { width: 18px; text-align: center; font-style: normal; }

    .admin-content { flex: 1; margin-left: 260px; padding: 32px 40px; min-height: 100vh; }
    .admin-content__header { margin-bottom: 32px; display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
    .admin-content__breadcrumb { font-size: 0.78rem; color: #999; margin-bottom: 6px; }
    .admin-content__breadcrumb a { color: #8FA86E; text-decoration: none; }
    .admin-content__breadcrumb a:hover { text-decoration: underline; }
    .admin-content__title { font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 600; color: #333; }

    .admin-card {
      background: #fff; border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06); padding: 24px 28px; margin-bottom: 20px;
      position: relative;
    }
    .admin-card__title { font-size: 1rem; font-weight: 600; color: #555; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .admin-card__index { font-size: 0.75rem; color: #8FA86E; background: #f0f6e8; padding: 4px 10px; border-radius: 999px; }

    .admin-form__group { margin-bottom: 16px; }
    .admin-form__label {
      display: block; font-size: 0.78rem; font-weight: 600; color: #555;
      margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .admin-form__input, .admin-form__textarea {
      width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 8px;
      font-size: 0.9rem; font-family: 'Montserrat', sans-serif; transition: border-color 0.2s;
    }
    .admin-form__input:focus, .admin-form__textarea:focus {
      outline: none; border-color: #8FA86E; box-shadow: 0 0 0 3px rgba(143,168,110,0.1);
    }
    .admin-form__hint { font-size: 0.72rem; color: #aaa; margin-top: 4px; }

    .admin-form__btn {
      display: inline-block; padding: 12px 32px; background: #8FA86E; color: #fff;
      border: none; border-radius: 8px; font-size: 0.95rem; font-weight: 600;
      font-family: 'Montserrat', sans-serif; cursor: pointer; transition: background 0.2s;
    }
    .admin-form__btn:hover { background: #6E8A4F; }
    .admin-btn--ghost {
      background: transparent; color: #8FA86E; border: 1px dashed #b7c596;
    }
    .admin-btn--ghost:hover { background: #f0f6e8; color: #6E8A4F; }
    .admin-btn--danger {
      background: transparent; color: #c0534f; border: 1px solid #e2b7b5;
      font-size: 0.8rem; padding: 6px 14px;
    }
    .admin-btn--danger:hover { background: #fce8e7; }

    .admin-alert {
      padding: 12px 20px; border-radius: 8px; margin-bottom: 24px; font-size: 0.88rem;
    }
    .admin-alert--success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }

    .admin-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .admin-form__image-preview {
      margin-top: 10px; max-width: 260px; border-radius: 8px; overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .admin-form__image-preview img { width: 100%; height: auto; display: block; }
    .slide-card__actions { display: flex; justify-content: flex-end; margin-top: 12px; }
    .btn-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 12px; }

    @media (max-width: 768px) {
      .admin-sidebar { width: 220px; }
      .admin-content { margin-left: 220px; padding: 24px 20px; }
      .admin-form__row { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="admin-sidebar__brand">
        <span class="admin-sidebar__brand-name"><%= content.site.name %></span>
        <span class="admin-sidebar__brand-sub">Админ-панель</span>
      </div>
      <nav class="admin-sidebar__nav">
        <a href="/admin" class="admin-sidebar__link">
          <span class="admin-sidebar__link-icon">&#9776;</span> Главная панель
        </a>
        <a href="/admin/settings" class="admin-sidebar__link">
          <span class="admin-sidebar__link-icon">&#9881;</span> Настройки сайта
        </a>
        <a href="/admin/hero" class="admin-sidebar__link admin-sidebar__link--active">
          <span class="admin-sidebar__link-icon">&#9733;</span> Главный экран
        </a>
        <a href="/admin/benefits" class="admin-sidebar__link">
          <span class="admin-sidebar__link-icon">&#10004;</span> Преимущества
        </a>
        <a href="/admin/services" class="admin-sidebar__link">
          <span class="admin-sidebar__link-icon">&#9998;</span> Разделы услуг
        </a>
        <div class="admin-sidebar__separator"></div>
        <a href="/admin/password" class="admin-sidebar__link">
          <span class="admin-sidebar__link-icon">&#128274;</span> Сменить пароль
        </a>
        <a href="/admin/logout" class="admin-sidebar__link admin-sidebar__link--danger">
          <span class="admin-sidebar__link-icon">&#10140;</span> Выход
        </a>
        <div class="admin-sidebar__separator"></div>
        <a href="/" class="admin-sidebar__link" target="_blank">
          <span class="admin-sidebar__link-icon">&#127760;</span> Вернуться на сайт
        </a>
      </nav>
    </aside>

    <main class="admin-content">
      <div class="admin-content__header">
        <div>
          <div class="admin-content__breadcrumb">
            <a href="/admin">Админ-панель</a> / Главный экран
          </div>
          <h1 class="admin-content__title">Hero-слайдер главной страницы</h1>
        </div>
      </div>

      <script>
        if (new URLSearchParams(window.location.search).get('saved') === '1') {
          document.addEventListener('DOMContentLoaded', function() {
            var el = document.getElementById('savedAlert');
            if (el) el.style.display = 'block';
          });
        }
      </script>

      <div class="admin-alert admin-alert--success" id="savedAlert" style="display:none;">
        Hero-слайдер успешно обновлён.
      </div>

      <%
        var slides = (content.hero.slides && content.hero.slides.length > 0) ? content.hero.slides : [{
          title: content.hero.title || '',
          subtitle: content.hero.subtitle || '',
          promoText: content.hero.promoText || '',
          promoNote: content.hero.promoNote || '',
          image: content.hero.image || ''
        }];
      %>

      <form method="POST" action="/admin/hero" class="admin-form" id="heroForm">
        <p style="font-size: 0.85rem; color: #666; margin-bottom: 20px; line-height: 1.6;">
          Слайды будут сменяться автоматически каждые 7 секунд. Первый — это основной экран, который видят все. Можно добавить сколько угодно. Картинки заливайте через раздел «<a href="/admin/gallery" style="color: #8FA86E;">Галерея</a>» или «Главный экран (старый аплоад)» и вставляйте путь сюда.
        </p>

        <div id="slidesContainer">
          <% slides.forEach(function(s, i) { %>
            <div class="admin-card slide-card" data-slide>
              <h2 class="admin-card__title">
                <span>Слайд</span>
                <span class="admin-card__index" data-slide-index-label>№ <%= i + 1 %></span>
              </h2>

              <div class="admin-form__group">
                <label class="admin-form__label">Заголовок</label>
                <input class="admin-form__input" type="text" name="slides[<%= i %>][title]" value="<%= s.title || '' %>">
              </div>

              <div class="admin-form__group">
                <label class="admin-form__label">Подзаголовок</label>
                <input class="admin-form__input" type="text" name="slides[<%= i %>][subtitle]" value="<%= s.subtitle || '' %>">
              </div>

              <div class="admin-form__row">
                <div class="admin-form__group">
                  <label class="admin-form__label">Промо-текст (оранжевая плашка)</label>
                  <input class="admin-form__input" type="text" name="slides[<%= i %>][promoText]" value="<%= s.promoText || '' %>">
                </div>
                <div class="admin-form__group">
                  <label class="admin-form__label">Сноска под кнопками</label>
                  <input class="admin-form__input" type="text" name="slides[<%= i %>][promoNote]" value="<%= s.promoNote || '' %>">
                </div>
              </div>

              <div class="admin-form__group">
                <label class="admin-form__label">Путь к изображению</label>
                <input class="admin-form__input" type="text" name="slides[<%= i %>][image]" value="<%= s.image || '' %>" placeholder="/uploads/... или /images/...">
                <div class="admin-form__hint">Путь на сайте, например <code>/uploads/hero-1.jpg</code>. Загрузить файл можно через <a href="/admin/gallery" style="color: #8FA86E;">раздел «Галерея»</a>.</div>
                <% if (s.image) { %>
                  <div class="admin-form__image-preview">
                    <img src="<%= s.image %>" alt="Slide image">
                  </div>
                <% } %>
              </div>

              <div class="slide-card__actions">
                <button type="button" class="admin-form__btn admin-btn--danger" data-remove-slide>Удалить слайд</button>
              </div>
            </div>
          <% }); %>
        </div>

        <div class="btn-row">
          <button type="button" class="admin-form__btn admin-btn--ghost" id="addSlideBtn">+ Добавить слайд</button>
          <button type="submit" class="admin-form__btn">Сохранить изменения</button>
        </div>
      </form>

    </main>
  </div>

  <!-- Template for a new slide -->
  <template id="slideTemplate">
    <div class="admin-card slide-card" data-slide>
      <h2 class="admin-card__title">
        <span>Слайд</span>
        <span class="admin-card__index" data-slide-index-label>№ ?</span>
      </h2>
      <div class="admin-form__group">
        <label class="admin-form__label">Заголовок</label>
        <input class="admin-form__input" type="text" data-field="title" value="">
      </div>
      <div class="admin-form__group">
        <label class="admin-form__label">Подзаголовок</label>
        <input class="admin-form__input" type="text" data-field="subtitle" value="">
      </div>
      <div class="admin-form__row">
        <div class="admin-form__group">
          <label class="admin-form__label">Промо-текст (оранжевая плашка)</label>
          <input class="admin-form__input" type="text" data-field="promoText" value="">
        </div>
        <div class="admin-form__group">
          <label class="admin-form__label">Сноска под кнопками</label>
          <input class="admin-form__input" type="text" data-field="promoNote" value="">
        </div>
      </div>
      <div class="admin-form__group">
        <label class="admin-form__label">Путь к изображению</label>
        <input class="admin-form__input" type="text" data-field="image" value="" placeholder="/uploads/... или /images/...">
        <div class="admin-form__hint">Путь на сайте, например <code>/uploads/hero-1.jpg</code>.</div>
      </div>
      <div class="slide-card__actions">
        <button type="button" class="admin-form__btn admin-btn--danger" data-remove-slide>Удалить слайд</button>
      </div>
    </div>
  </template>

  <script>
    (function () {
      const container = document.getElementById('slidesContainer');
      const addBtn = document.getElementById('addSlideBtn');
      const tpl = document.getElementById('slideTemplate');

      function reindex() {
        const cards = container.querySelectorAll('[data-slide]');
        cards.forEach((card, i) => {
          const label = card.querySelector('[data-slide-index-label]');
          if (label) label.textContent = '№ ' + (i + 1);
          card.querySelectorAll('[data-field]').forEach((inp) => {
            const field = inp.getAttribute('data-field');
            inp.name = 'slides[' + i + '][' + field + ']';
          });
          // fix existing named inputs too (for items rendered on server)
          card.querySelectorAll('input[name^="slides["]').forEach((inp) => {
            const match = inp.name.match(/^slides\[\d+\]\[(\w+)\]$/);
            if (match) inp.name = 'slides[' + i + '][' + match[1] + ']';
          });
        });
      }

      addBtn.addEventListener('click', () => {
        const frag = tpl.content.cloneNode(true);
        container.appendChild(frag);
        reindex();
      });

      container.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-remove-slide]');
        if (!btn) return;
        if (!confirm('Удалить этот слайд?')) return;
        const card = btn.closest('[data-slide]');
        if (card) card.remove();
        reindex();
      });
    })();
  </script>
</body>
</html>
