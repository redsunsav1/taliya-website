  <!-- ===== FOOTER ===== -->
  <footer class="footer">
    <div class="footer__grid">
      <div>
        <p class="footer__title"><%= content.site.name %></p>
        <p class="footer__text"><%= (content.footer && content.footer.tagline) || content.site.tagline %></p>
        <p class="footer__text" style="margin-top:10px;"><%= content.site.company %></p>
        <% if (content.site.license) { %>
          <p class="footer__text" style="font-size:12px;">Лицензия: <%= content.site.license %></p>
        <% } %>
      </div>
      <div>
        <span class="footer__h">Навигация</span>
        <ul class="footer__list">
          <li><a href="/about">О нас</a></li>
          <li><a href="/team">Специалисты</a></li>
          <li><a href="/gallery">Галерея</a></li>
          <li><a href="/promotions">Акции</a></li>
        </ul>
      </div>
      <div>
        <span class="footer__h">Контакты</span>
        <ul class="footer__list">
          <% if (content.site.phone) { %>
            <li><a href="tel:<%= content.site.phoneRaw %>"><%= content.site.phone %></a></li>
          <% } %>
          <% if (content.site.phone2) { %>
            <li><a href="tel:<%= content.site.phoneRaw2 %>"><%= content.site.phone2 %></a></li>
          <% } %>
          <% if (content.site.address) { %>
            <li><%= content.site.address %></li>
          <% } %>
          <% if (content.site.hours) { %>
            <li><%= content.site.hours %></li>
          <% } %>
        </ul>
      </div>
      <div>
        <span class="footer__h">Мы в соцсетях</span>
        <ul class="footer__list">
          <% if (content.site.vk) { %>
            <li><a href="<%= content.site.vk %>" target="_blank" rel="noopener">ВКонтакте</a></li>
          <% } %>
          <% if (content.site.telegram) { %>
            <li><a href="<%= content.site.telegram %>" target="_blank" rel="noopener">Телеграм</a></li>
          <% } %>
          <% if (content.site.whatsapp) { %>
            <li><a href="<%= content.site.whatsapp %>" target="_blank" rel="noopener">Ватсап</a></li>
          <% } %>
          <% if (content.site.profsalon) { %>
            <li><a href="<%= content.site.profsalon %>" target="_blank" rel="noopener">Онлайн-запись</a></li>
          <% } %>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© <%= new Date().getFullYear() %> <%= content.site.company %>. Все права защищены.</span>
      <span class="footer__legal">
        <% var legal = (content.footer && content.footer.legal) || [
            { text: 'Политика конфиденциальности', href: '/privacy' },
            { text: 'Пользовательское соглашение', href: '/terms' },
            { text: 'Согласие на обработку данных', href: '/consent' }
        ]; %>
        <% legal.forEach(function(l){ %>
          <a href="<%= l.href %>"><%= l.text %></a>
        <% }); %>
      </span>
    </div>
  </footer>

  </main>

  <!-- ===== FLOATING BUTTONS ===== -->
  <% var fw = (content.floating && content.floating.whatsapp) || {}; %>
  <% var fp = (content.floating && content.floating.profsalon) || {}; %>
  <% if (fw.enabled && (fw.href || content.site.whatsapp)) { %>
    <a href="<%= fw.href || content.site.whatsapp %>" target="_blank" rel="noopener" class="whatsapp-float" aria-label="Написать в Ватсап">
      <i data-lucide="message-circle"></i>
    </a>
  <% } %>
  <% if (fp.enabled && (fp.href || content.site.profsalon)) { %>
    <a href="<%= fp.href || content.site.profsalon %>" target="_blank" rel="noopener" class="booking-float">
      <i data-lucide="calendar-check"></i>
      <span><%= fp.text || 'Записаться онлайн' %></span>
    </a>
  <% } %>

  <script src="/js/v2.js"></script>
  <script>
    if (window.lucide) { lucide.createIcons(); }
  </script>
</body>
</html>
