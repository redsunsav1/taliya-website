  <!-- Уведомление о файлах куки (имена классов нейтральные: блокировщики рекламы
       скрывают элементы с «cookie»/«consent» в названии) -->
  <div class="tly-notice" id="tlyNotice" style="display:none;">
    <div class="tly-notice__content">
      <p>Мы используем файлы куки (cookies), необходимые для работы сайта и сохранения ваших настроек. Сторонние счётчики и рекламные трекеры не используются. Подробнее — в <a href="/privacy" class="link-inline">Политике конфиденциальности</a>.</p>
      <div class="tly-notice__actions">
        <button class="tly-notice__btn" id="tlyNoticeYes">Принять</button>
        <button class="tly-notice__btn tly-notice__btn--ghost" id="tlyNoticeNo">Отклонить</button>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="/js/main.js?v=20260727"></script>
  <script>
    // Initialize Lucide icons (script is deferred — wait for it)
    document.addEventListener('DOMContentLoaded', function() {
      if (window.lucide) { try { lucide.createIcons(); } catch (e) {} }
    });

    // Уведомление о куки. Ключ версионный: при изменении текста уведомления
    // поднимаем версию, чтобы посетители увидели новую редакцию и ответили заново.
    (function() {
      var STORAGE_KEY = 'tlyNoticeAck.v2';
      var banner = document.getElementById('tlyNotice');
      var btnAccept = document.getElementById('tlyNoticeYes');
      var btnDecline = document.getElementById('tlyNoticeNo');
      if (!banner || !btnAccept || !btnDecline) return;

      var answered;
      try { answered = localStorage.getItem(STORAGE_KEY); } catch (e) { answered = null; }

      if (!answered) {
        // important — чтобы косметические фильтры блокировщиков не перебили показ
        banner.style.setProperty('display', 'flex', 'important');
      }
      function close(value) {
        try { localStorage.setItem(STORAGE_KEY, value); } catch (e) {}
        banner.style.setProperty('display', 'none', 'important');
      }
      btnAccept.addEventListener('click', function() { close('accepted'); });
      btnDecline.addEventListener('click', function() { close('declined'); });
    })();
  </script>
