<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<%
  /* ===== SEO: заголовок, описание и ссылки страницы =====
     Значения берутся из «Админка → SEO» (content.seo), для услуг — из полей seoTitle/seoDescription услуги.
     Если поле пустое — используется прежний вариант, чтобы ничего не сломать. */
  const seoData = content.seo || {};
  const seoPath = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '/';
  const seoKey = seoPath === '/' ? 'home' : seoPath.replace(/^\/+/, '').split('/')[0];
  const seoService = (typeof service !== 'undefined' && service) ? service : null;
  const seoLegal = {
    privacy: 'Политика обработки персональных данных',
    terms: 'Условия использования сайта',
    consent: 'Согласие на обработку персональных данных',
    offer: 'Договор-оферта на медицинские услуги'
  };
  const seoClean = (v) => String(v || '').replace(/\s+/g, ' ').trim();
  const seoCut = (v, n) => { v = seoClean(v); return v.length > n ? v.slice(0, n - 1).replace(/[\s,.;:—-]+[^\s]*$/, '') + '…' : v; };
  const defaultDesc = content.site.name + ' — ' + content.site.tagline + '. ' + content.site.address + '. Лицензия ' + content.site.license;
  let metaTitle = '', metaDesc = '', metaKeywords = '';
  if (seoService) {
    metaTitle = seoClean(seoService.seoTitle) || (seoService.name + ' в Мытищах — цены | ' + content.site.name);
    metaDesc = seoClean(seoService.seoDescription) || seoCut(seoService.description, 160);
    metaKeywords = seoClean(seoService.seoKeywords);
  } else {
    metaTitle = seoClean(seoData[seoKey + 'Title']) || (seoLegal[seoKey] ? seoLegal[seoKey] + ' | ' + content.site.name : '');
    metaDesc = seoClean(seoData[seoKey + 'Description']);
    metaKeywords = seoClean(seoData[seoKey + 'Keywords']);
  }
  const noindexPage = typeof noindex !== 'undefined' && noindex;
  if (noindexPage) metaTitle = 'Страница не найдена | ' + content.site.name;
  if (!metaTitle) metaTitle = content.site.name + ' — ' + content.site.tagline;
  if (!metaDesc) metaDesc = defaultDesc;
  if (!metaKeywords) metaKeywords = seoClean(seoData.homeKeywords) || 'косметология Мытищи, эстетика тела, центр красоты, массаж, лазерная эпиляция, эндосфера-терапия';
  const siteUrl = (seoClean(seoData.canonical) || seoClean(content.site.url) || 'https://tali-ya.ru').replace(/\/+$/, '');
  const canonicalUrl = siteUrl + seoPath;
  const heroImg = content.hero && (content.hero.image || (content.hero.slides && content.hero.slides[0] && content.hero.slides[0].image));
  let ogImage = seoClean(seoData.ogImage) || seoClean(heroImg) || '/images/logo.svg';
  if (ogImage.startsWith('/')) ogImage = siteUrl + ogImage;
%>
  <meta name="description" content="<%= metaDesc %>">
  <meta name="theme-color" content="#A3A282">
  <meta name="keywords" content="<%= metaKeywords %>">
  <meta name="robots" content="<%= noindexPage ? 'noindex, follow' : 'index, follow' %>">
  <meta name="author" content="<%= content.site.company %>">
  <% if (!noindexPage) { %><link rel="canonical" href="<%= canonicalUrl %>"><% } %>

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= content.site.name %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:title" content="<%= metaTitle %>">
  <meta property="og:description" content="<%= metaDesc %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:locale" content="ru_RU">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="<%= canonicalUrl %>">
  <meta name="twitter:title" content="<%= metaTitle %>">
  <meta name="twitter:description" content="<%= metaDesc %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <title><%= metaTitle %></title>

  <link rel="icon" href="<%= content.site.favicon || '/images/favicon.svg' %>" type="image/svg+xml">
  <link rel="stylesheet" href="/fonts/fonts.css?v=20260908">
  <link rel="stylesheet" href="/css/style.css?v=20261026-2">
  <script src="/js/lucide.min.js?v=20260908" defer></script>

<%
  const ldBusiness = {
    '@context': 'https://schema.org',
    '@type': ['MedicalBusiness', 'BeautySalon'],
    '@id': siteUrl + '/#organization',
    name: content.site.name,
    alternateName: 'ТалиЯ',
    description: content.site.tagline + ' в Мытищах',
    url: siteUrl + '/',
    logo: siteUrl + (content.site.logo || '/images/logo.svg'),
    image: ogImage,
    telephone: [content.site.phoneRaw, content.site.phoneRaw2].filter(Boolean),
    email: content.site.email || undefined,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'ул. Мира, 35, ЖК «Ярославский»',
      addressLocality: 'Мытищи',
      addressRegion: 'Московская область',
      postalCode: '141008',
      addressCountry: 'RU'
    },
    geo: { '@type': 'GeoCoordinates', latitude: 55.9103, longitude: 37.7647 },
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '10:00',
      closes: '22:00'
    },
    priceRange: '₽₽',
    areaServed: { '@type': 'City', name: 'Мытищи' },
    sameAs: [content.site.vk, content.site.max].filter(Boolean),
    legalName: content.site.company || undefined,
    taxID: content.site.inn || undefined
  };
  const ldJson = (o) => JSON.stringify(o).replace(/</g, '\\u003c');
%>
  <script type="application/ld+json"><%- ldJson(ldBusiness) %></script>
  <% if (seoService) { %>
  <script type="application/ld+json"><%- ldJson({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: seoService.name, item: canonicalUrl }
    ]
  }) %></script>
  <% } %>
</head>
<body class="has-sidebar">

  <!-- ===== MOBILE TOP BAR ===== -->
  <header class="topbar" id="topbar">
    <div class="topbar__inner">
      <a href="/" class="topbar__logo">
        <% if (content.site.logo) { %>
          <img src="<%= content.site.logo %>" alt="<%= content.site.name %>">
        <% } else { %>
          <span class="topbar__logo-name"><%= content.site.name %></span>
        <% } %>
      </a>
      <button class="topbar__burger" id="headerBurger" aria-label="Открыть меню" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <!-- ===== SIDEBAR (DESKTOP + MOBILE OVERLAY) ===== -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar__inner">

      <!-- Logo -->
      <a href="/" class="sidebar__logo">
        <% if (content.site.logo) { %>
          <img src="<%= content.site.logo %>" alt="<%= content.site.name %>" class="sidebar__logo-img">
        <% } else { %>
          <div class="sidebar__logo-text">
            <span class="sidebar__logo-name"><%= content.site.name %></span>
            <span class="sidebar__logo-tagline">Центр красоты</span>
          </div>
        <% } %>
      </a>

      <!-- Navigation -->
      <nav class="sidebar__nav" aria-label="Основная навигация">
        <ul class="sidebar__nav-list">
          <li>
            <a href="/" class="sidebar__nav-link<%= currentPath === '/' ? ' sidebar__nav-link--active' : '' %>">
              <span>Главная</span>
            </a>
          </li>
          <li>
            <a href="/about" class="sidebar__nav-link<%= currentPath === '/about' ? ' sidebar__nav-link--active' : '' %>">
              <span>О нас</span>
            </a>
          </li>
          <li class="sidebar__nav-item--expandable">
            <a href="#services" class="sidebar__nav-link">
              <span>Услуги</span>
              <i data-lucide="chevron-down" class="sidebar__nav-caret"></i>
            </a>
            <ul class="sidebar__subnav">
              <% content.services.forEach(function(s) { %>
                <li><a href="/service/<%= s.slug %>" class="sidebar__subnav-link"><%= s.shortName %></a></li>
              <% }); %>
            </ul>
          </li>
          <li>
            <a href="/team" class="sidebar__nav-link<%= currentPath === '/team' ? ' sidebar__nav-link--active' : '' %>">
              <span>Мастера</span>
            </a>
          </li>
          <li>
            <a href="/gallery" class="sidebar__nav-link<%= currentPath === '/gallery' ? ' sidebar__nav-link--active' : '' %>">
              <span>Портфолио</span>
            </a>
          </li>
          <li>
            <a href="/promotions" class="sidebar__nav-link<%= currentPath === '/promotions' ? ' sidebar__nav-link--active' : '' %>">
              <span>Акции</span>
            </a>
          </li>
          <li>
            <a href="/contacts" class="sidebar__nav-link<%= currentPath === '/contacts' ? ' sidebar__nav-link--active' : '' %>">
              <span>Контакты</span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Contacts block -->
      <div class="sidebar__contacts">
        <a href="tel:<%= content.site.phoneRaw %>" class="sidebar__phone"><%= content.site.phone %></a>
        <% if (content.site.phone2) { %>
          <a href="tel:<%= content.site.phoneRaw2 %>" class="sidebar__phone sidebar__phone--secondary"><%= content.site.phone2 %></a>
        <% } %>
        <p class="sidebar__address"><%= content.site.address %></p>
      </div>

      <!-- Socials -->
      <div class="sidebar__socials">
        <% if (content.site.max) { %>
          <a href="<%= content.site.max %>" target="_blank" rel="noopener" class="sidebar__social" aria-label="МАКС">
            <i data-lucide="message-circle"></i>
          </a>
        <% } %>
        <% if (content.site.vk) { %>
          <a href="<%= content.site.vk %>" target="_blank" rel="noopener" class="sidebar__social" aria-label="ВКонтакте">
            <i data-lucide="users"></i>
          </a>
        <% } %>
      </div>
    </div>
  </aside>

  <!-- Sidebar backdrop (mobile) -->
  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

  <main class="page" id="page">
