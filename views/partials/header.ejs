<%
var cp = (typeof currentPath !== 'undefined' ? currentPath : (typeof res !== 'undefined' && res.locals ? res.locals.currentPath : '/')) || '/';
function navClass(path){ return 'sidebar__nav-link' + (cp === path ? ' sidebar__nav-link--active' : ''); }
%><!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= content.site.name %> — <%= content.site.tagline %>. <%= content.site.address %>. Лицензия <%= content.site.license %>">
  <meta name="theme-color" content="#FFFFFF">
  <meta name="keywords" content="косметология Мытищи, эстетика тела, центр красоты, массаж, лазерная эпиляция, эндосфера-терапия">
  <meta name="robots" content="index, follow">
  <meta name="author" content="<%= content.site.company %>">

  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : '' %><%= content.site.name %>">
  <meta property="og:description" content="<%= content.site.name %> — <%= content.site.tagline %>. <%= content.site.address %>.">
  <meta property="og:locale" content="ru_RU">

  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : '' %><%= content.site.name %> — <%= content.site.tagline %></title>

  <link rel="icon" href="<%= content.site.favicon || '/images/favicon.svg' %>" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/v2.css">
  <% if (typeof pageStyles !== 'undefined' && Array.isArray(pageStyles)) { pageStyles.forEach(function(href){ %>
    <link rel="stylesheet" href="<%= href %>">
  <% }); } %>
  <script src="https://unpkg.com/lucide@latest"></script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "LocalBusiness",
    "name": "<%= content.site.name %>",
    "description": "<%= content.site.tagline %>",
    "telephone": "<%= content.site.phoneRaw %>",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "<%= content.site.address %>",
      "addressLocality": "Мытищи",
      "addressRegion": "Московская область",
      "addressCountry": "RU"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "10:00",
      "closes": "22:00"
    },
    "priceRange": "$$",
    "sameAs": [
      "<%= content.site.vk %>",
      "<%= content.site.telegram %>",
      "<%= content.site.whatsapp %>"
    ],
    "license": "<%= content.site.license %>"
  }
  </script>
</head>
<body class="has-sidebar">

  <!-- Mobile top bar -->
  <header class="topbar">
    <div class="topbar__inner">
      <a href="/" class="topbar__logo">
        <img src="<%= content.site.logo || '/images/logo.svg' %>" alt="<%= content.site.name %>">
      </a>
      <button class="topbar__burger" id="headerBurger" aria-expanded="false" aria-label="Меню">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <!-- Sidebar (horizontal header) -->
  <aside class="sidebar" id="sidebar">
    <a href="/" class="sidebar__logo">
      <img src="<%= content.site.logo || '/images/logo.svg' %>" alt="<%= content.site.name %>">
    </a>

    <nav class="sidebar__nav">
      <ul class="sidebar__nav-list">
        <li><a href="/" class="<%= navClass('/') %>"><span>Главная</span></a></li>
        <li><a href="/about" class="<%= navClass('/about') %>"><span>О нас</span></a></li>
        <li class="sidebar__nav-item--expandable">
          <a href="#services" class="sidebar__nav-link<%= cp.indexOf('/service') === 0 ? ' sidebar__nav-link--active' : '' %>">
            <span>Услуги</span>
            <i data-lucide="chevron-down" class="sidebar__nav-caret"></i>
          </a>
          <ul class="sidebar__subnav">
            <% (content.services || []).forEach(function(s){ %>
              <li><a href="/service/<%= s.slug %>" class="sidebar__subnav-link"><%= s.shortName || s.name %></a></li>
            <% }); %>
          </ul>
        </li>
        <li><a href="/team" class="<%= navClass('/team') %>"><span>Мастера</span></a></li>
        <li><a href="/gallery" class="<%= navClass('/gallery') %>"><span>Портфолио</span></a></li>
        <li><a href="/promotions" class="<%= navClass('/promotions') %>"><span>Акции</span></a></li>
        <li><a href="/contacts" class="<%= navClass('/contacts') %>"><span>Контакты</span></a></li>
      </ul>
    </nav>

    <div class="sidebar__contacts">
      <a href="tel:<%= content.site.phoneRaw %>" class="sidebar__phone"><%= content.site.phone %></a>
      <% if (content.site.phone2) { %>
        <a href="tel:<%= content.site.phoneRaw2 %>" class="sidebar__phone sidebar__phone--secondary"><%= content.site.phone2 %></a>
      <% } %>
      <p class="sidebar__address"><%= content.site.address %></p>
    </div>

    <div class="sidebar__socials">
      <% if (content.site.whatsapp) { %>
        <a href="<%= content.site.whatsapp %>" target="_blank" rel="noopener" class="sidebar__social" aria-label="WhatsApp"><i data-lucide="message-circle"></i></a>
      <% } %>
      <% if (content.site.telegram) { %>
        <a href="<%= content.site.telegram %>" target="_blank" rel="noopener" class="sidebar__social" aria-label="Telegram"><i data-lucide="send"></i></a>
      <% } %>
      <% if (content.site.vk) { %>
        <a href="<%= content.site.vk %>" target="_blank" rel="noopener" class="sidebar__social" aria-label="VK"><i data-lucide="users"></i></a>
      <% } %>
    </div>
  </aside>
  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

  <main class="page">
