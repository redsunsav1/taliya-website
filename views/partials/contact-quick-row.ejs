<div class="contact-quick-row">
  <% var maxUrl = content.site.max || (typeof maxChatUrl !== 'undefined' && maxChatUrl) || ''; %>
  <% if (maxUrl) { %>
    <a href="<%= maxUrl %>" target="_blank" rel="noopener" class="contact-quick-row__btn" title="Написать в МАКСе">
      <i data-lucide="message-circle"></i>
      <span>МАКС</span>
    </a>
  <% } %>
  <% if (content.site.vk) { %>
    <a href="<%= content.site.vk %>" target="_blank" rel="noopener" class="contact-quick-row__btn" title="ВКонтакте">
      <i data-lucide="users"></i>
      <span>ВКонтакте</span>
    </a>
  <% } %>
  <% if (content.site.phoneRaw) { %>
    <a href="tel:<%= content.site.phoneRaw %>" class="contact-quick-row__btn" title="Позвонить">
      <i data-lucide="phone"></i>
      <span>Позвонить</span>
    </a>
  <% } %>
</div>
