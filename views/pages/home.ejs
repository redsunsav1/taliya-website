<% var pageTitle = ''; %>
<%- include('../partials/header') %>

<!-- ===== SPLIT HERO ===== -->
<%
  var activePromos = (content.promotions && content.promotions.items ? content.promotions.items : []).filter(function(p) { return p.active !== false; });
  var heroSlides = (content.hero.slides && content.hero.slides.length > 0) ? content.hero.slides : [{
    title: content.hero.title,
    subtitle: content.hero.subtitle,
    promoText: content.hero.promoText,
    promoNote: content.hero.promoNote,
    image: content.hero.image
  }];
  var heroTotal = heroSlides.length;
  var pad = function(n) { return n < 10 ? '0' + n : '' + n; };
%>
<section class="hero-split" id="hero" data-hero-slider>
  <div class="hero-split__grid">

    <!-- Left: green card -->
    <div class="hero-split__card fade-in">
      <div class="hero-split__card-top">
        <span class="hero-split__eyebrow">
          <i data-lucide="leaf" style="width: 14px; height: 14px;"></i>
          <%= content.site.tagline %>
        </span>
      </div>

      <div class="hero-split__heading">
        <h1 class="hero-split__brand">ТАЛИЯ</h1>
        <p class="hero-split__subbrand">Мед. лицензия № Л041-01162-50/00622568</p>
      </div>

      <p class="hero-split__positioning"><%= content.hero.subtitle %></p>

      <ul class="hero-utp">
        <li><span class="hero-utp__dot"></span>Аппаратная косметология</li>
        <li><span class="hero-utp__dot"></span>Инъекции красоты</li>
        <li><span class="hero-utp__dot"></span>Лечебные массажи</li>
        <li><span class="hero-utp__dot"></span>Программы коррекции фигуры</li>
        <li><span class="hero-utp__dot"></span>Подология и орто-стельки</li>
        <li><span class="hero-utp__dot"></span>Маникюр и педикюр</li>
      </ul>

      <div class="hero-split__slides-text" data-hero-text-track>
        <% heroSlides.forEach(function(slide, i) { %>
          <div class="hero-split__slide-text<%= i === 0 ? ' is-active' : '' %>" data-hero-slide-text="<%= i %>">
            <% if (slide.promoText) { %>
              <div class="hero-split__promo">
                <i data-lucide="sparkles" style="width: 16px; height: 16px;"></i>
                <span><%= slide.promoText %></span>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>

      <div class="hero-split__cta">
        <a href="#callback" class="btn btn--accent btn--lg">
          <i data-lucide="calendar-check"></i>
          Записаться
        </a>
        <% if (activePromos && activePromos.length > 0) { %>
          <a href="#promoCarousel" class="btn btn--ghost-light btn--lg">
            <i data-lucide="tag"></i>
            <span>Узнать акции</span>
          </a>
        <% } else { %>
          <a href="/promotions" class="btn btn--ghost-light btn--lg">
            <i data-lucide="tag"></i>
            <span>Узнать акции</span>
          </a>
        <% } %>
      </div>

      <div class="hero-social hero-social--icons">
        <% if (content.site.vk) { %>
          <a href="<%= content.site.vk %>" target="_blank" rel="noopener" class="hero-social__btn" aria-label="ВКонтакте" title="ВКонтакте">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2.4 5.5h3.3c.18 1.78 1 4.06 2.55 5.5V5.5H11v3.7c1.55-.05 3.05-2.13 3.55-3.7h3.1c-.6 2.05-2.05 4.1-3.4 5 1.55.7 3.25 2.5 3.95 5h-3.45c-.6-1.85-2-3.3-3.75-3.3v3.3h-.4C5.85 15.5 2.7 11.85 2.4 5.5z"/></svg>
          </a>
        <% } %>
        <% if (content.site.max) { %>
          <a href="<%= content.site.max %>" target="_blank" rel="noopener" class="hero-social__btn" aria-label="MAX мессенджер" title="MAX">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M7 16V8.5l5 5 5-5V16"/></svg>
          </a>
        <% } %>
      </div>

      <div class="hero-split__notes" data-hero-notes>
        <% heroSlides.forEach(function(slide, i) { %>
          <% if (slide.promoNote) { %>
            <p class="hero-split__note<%= i === 0 ? ' is-active' : '' %>" data-hero-slide-note="<%= i %>"><%= slide.promoNote %></p>
          <% } else { %>
            <p class="hero-split__note<%= i === 0 ? ' is-active' : '' %>" data-hero-slide-note="<%= i %>">&nbsp;</p>
          <% } %>
        <% }); %>
      </div>

      <p class="med-disclaimer med-disclaimer--dark">Имеются противопоказания. Необходима консультация специалиста.</p>

      <% if (heroTotal > 1) { %>
      <div class="hero-split__arrows">
        <button type="button" class="hero-split__arrow" data-hero-prev aria-label="Предыдущий слайд">
          <i data-lucide="arrow-left"></i>
        </button>
        <button type="button" class="hero-split__arrow" data-hero-next aria-label="Следующий слайд">
          <i data-lucide="arrow-right"></i>
        </button>
      </div>
      <% } %>

      <div class="hero-split__meta">
        <div class="hero-split__meta-item">
          <span class="hero-split__meta-label">Адрес</span>
          <span class="hero-split__meta-value"><%= content.site.address %></span>
        </div>
        <div class="hero-split__meta-item">
          <span class="hero-split__meta-label">Режим</span>
          <span class="hero-split__meta-value"><%= content.site.hours %></span>
        </div>
      </div>
    </div>

    <!-- Right: photo -->
    <div class="hero-split__media fade-in delay-2">
      <div class="hero-split__media-inner" data-hero-media-track>
        <% heroSlides.forEach(function(slide, i) { %>
          <img src="<%= slide.image %>" alt="<%= slide.title || content.site.name %>" class="hero-split__image<%= i === 0 ? ' is-active' : '' %>" data-hero-slide-image="<%= i %>">
        <% }); %>
        <div class="hero-split__tag">
          <i data-lucide="shield-check" style="width: 14px; height: 14px;"></i>
          <span>Медицинская лицензия</span>
        </div>
        <% if (heroTotal > 1) { %>
        <div class="hero-split__media-counter" aria-hidden="true">
          <span class="hero-split__media-counter-num" data-hero-counter>01</span>
          <span class="hero-split__media-counter-sep">/</span>
          <span class="hero-split__media-counter-total"><%= pad(heroTotal) %></span>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</section>


<!-- ===== PROMO CAROUSEL ===== -->
<% if (activePromos.length > 0) { %>
<section class="promo-carousel" id="promoCarousel" aria-label="Специальные предложения">
  <div class="promo-carousel__inner">
    <div class="promo-carousel__header">
      <div class="promo-carousel__heading">
        <span class="eyebrow">Специальные предложения</span>
        <h2 class="promo-carousel__title"><%= content.promotions.title || 'Акции и выгодные предложения' %></h2>
        <% if (content.promotions && content.promotions.subtitle) { %>
          <p class="promo-carousel__subtitle"><%= content.promotions.subtitle %></p>
        <% } %>
      </div>
      <% if (activePromos.length > 1) { %>
      <div class="promo-carousel__controls">
        <button type="button" class="promo-carousel__btn" data-promo-prev aria-label="Предыдущая акция">
          <i data-lucide="arrow-left"></i>
        </button>
        <button type="button" class="promo-carousel__btn" data-promo-next aria-label="Следующая акция">
          <i data-lucide="arrow-right"></i>
        </button>
      </div>
      <% } %>
    </div>

    <div class="promo-carousel__viewport">
      <div class="promo-carousel__track" data-promo-track>
        <% activePromos.forEach(function(promo, i) { %>
          <div class="promo-slide" data-promo-slide>
            <article class="promo-card">
              <div class="promo-card__media">
                <% if (promo.image) { %>
                  <img src="<%= promo.image %>" alt="<%= promo.title %>" class="promo-card__image">
                <% } else { %>
                  <div class="promo-card__icon">
                    <i data-lucide="<%= promo.icon || 'sparkles' %>"></i>
                  </div>
                <% } %>
              </div>
              <div class="promo-card__body">
                <% if (promo.badge) { %>
                  <span class="promo-card__badge"><%= promo.badge %></span>
                <% } %>
                <h3 class="promo-card__title"><%= promo.title %></h3>
                <p class="promo-card__description"><%= promo.description %></p>
                <a href="<%= promo.link || content.site.profsalon || '/promotions' %>" <%= promo.link && promo.link.indexOf('http') === 0 ? 'target="_blank" rel="noopener"' : '' %> class="btn btn--primary btn--sm" style="align-self: flex-start; margin-top: var(--space-sm);">
                  <i data-lucide="calendar-check"></i>
                  Воспользоваться
                </a>
              </div>
            </article>
          </div>
        <% }); %>
      </div>
    </div>

    <% if (activePromos.length > 1) { %>
    <div class="promo-carousel__dots" data-promo-dots>
      <% activePromos.forEach(function(_, i) { %>
        <button type="button" class="promo-carousel__dot<%= i === 0 ? ' promo-carousel__dot--active' : '' %>" data-promo-dot="<%= i %>" aria-label="Слайд <%= i + 1 %>"></button>
      <% }); %>
    </div>
    <% } %>
  </div>
</section>
<% } %>


<!-- ===== BENEFITS SECTION ===== -->
<section class="benefits section" id="benefits">
  <div class="container">
    <div class="section__header">
      <span class="eyebrow fade-in">Преимущества</span>
      <h2 class="section__title fade-in">Почему нам доверяют</h2>
      <p class="section__subtitle fade-in">Мы создаём пространство, где забота о себе становится удовольствием</p>
    </div>

    <div class="benefits__grid">
      <% content.benefits.forEach(function(b, i) { %>
        <div class="benefit-card fade-in delay-<%= Math.min(i + 1, 6) %>">
          <div class="benefit-card__icon">
            <i data-lucide="<%= b.icon %>"></i>
          </div>
          <div class="benefit-card__body">
            <h3 class="benefit-card__title"><%= b.title %></h3>
            <p class="benefit-card__text"><%= b.text %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>


<!-- ===== SERVICES SECTION ===== -->
<section class="services-section section" id="services">
  <div class="container">
    <div class="section__header">
      <span class="eyebrow fade-in">Что мы предлагаем</span>
      <h2 class="section__title fade-in">Стоимость и перечень услуг</h2>
      <p class="section__subtitle fade-in">Широкий спектр процедур для вашей красоты и здоровья</p>
    </div>

    <div class="services__grid">
      <% content.services.forEach(function(s, i) { %>
        <a href="/service/<%= s.slug %>" class="service-card fade-in delay-<%= Math.min(i + 1, 6) %>">
          <div class="service-card__image-wrap">
            <img
              data-src="<%= s.image %>"
              src="<%= s.image %>"
              alt="<%= s.name %>"
              class="service-card__image"
              loading="lazy"
            >
          </div>
          <div class="service-card__body">
            <% if (s.offerBadge || s.discount) { %>
              <span class="service-card__discount"><%= s.offerBadge || s.discount %></span>
            <% } %>
            <h3 class="service-card__name"><%= s.shortName || s.name %></h3>
            <p class="service-card__brief"><%= s.description ? s.description.substring(0, 110) + (s.description.length > 110 ? '...' : '') : '' %></p>
            <div class="service-card__bottom">
              <span class="service-card__more">Подробнее</span>
              <span class="service-card__arrow">
                <i data-lucide="arrow-right"></i>
              </span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>


<!-- ===== ABOUT / CTA SECTION ===== -->
<section class="about-cta section" id="about">
  <div class="container">
    <div class="about-cta__panel fade-in">
      <span class="eyebrow eyebrow--light">О центре</span>
      <h2 class="section__title section__title--light">Работаем с любовью, предвосхищая ожидания</h2>
      <p class="about-cta__text">
        <%= content.site.name %> — это центр эстетики тела и косметологии, где каждая процедура
        выполняется с вниманием к деталям. Наши специалисты подбирают индивидуальные программы,
        учитывая особенности каждого клиента, чтобы результат превосходил ожидания.
      </p>
      <div class="about-cta__chip">
        <i data-lucide="shield-check"></i>
        <span>Только оригинальные препараты</span>
      </div>
      <div class="about-cta__actions">
        <a href="<%= content.site.profsalon %>" target="_blank" rel="noopener" class="btn btn--accent btn--lg">
          <i data-lucide="calendar-check"></i>
          Записаться на процедуру
        </a>
        <a href="/about" class="btn btn--ghost-light btn--lg">
          О нас подробнее
          <i data-lucide="arrow-right"></i>
        </a>
      </div>
    </div>
  </div>
</section>


<!-- ===== CONTACT PREVIEW SECTION ===== -->
<section class="contact-preview section" id="contact-preview">
  <div class="container">
    <div class="section__header">
      <span class="eyebrow fade-in">Контакты</span>
      <h2 class="section__title fade-in">Как нас найти</h2>
      <p class="section__subtitle fade-in">Будем рады видеть вас в нашем центре</p>
    </div>

    <div class="contact-preview__grid fade-in">

      <div class="contact-card">
        <div class="contact-card__icon">
          <i data-lucide="map-pin"></i>
        </div>
        <div class="contact-card__body">
          <p class="contact-card__label">Адрес</p>
          <p class="contact-card__value"><%= content.site.address %></p>
        </div>
      </div>

      <div class="contact-card">
        <div class="contact-card__icon">
          <i data-lucide="phone"></i>
        </div>
        <div class="contact-card__body">
          <p class="contact-card__label">Телефон</p>
          <p class="contact-card__value">
            <a href="tel:<%= content.site.phoneRaw %>"><%= content.site.phone %></a>
            <% if (content.site.phone2) { %>
              <br><a href="tel:<%= content.site.phoneRaw2 %>"><%= content.site.phone2 %></a>
            <% } %>
          </p>
        </div>
      </div>

      <div class="contact-card">
        <div class="contact-card__icon">
          <i data-lucide="clock"></i>
        </div>
        <div class="contact-card__body">
          <p class="contact-card__label">Часы работы</p>
          <p class="contact-card__value"><%= content.site.hours %></p>
        </div>
      </div>

    </div>

    <div class="contact-preview__footer fade-in">
      <div class="contact-preview__rating">
        <i data-lucide="star" style="width: 16px; height: 16px;"></i>
        <span>5.0 — Отличное место</span>
      </div>
      <a href="/contacts" class="btn btn--primary">
        <i data-lucide="map"></i>
        Контакты и карта
      </a>
    </div>
  </div>
</section>

<!-- ===== CALLBACK FORM ===== -->
<%- include('../partials/callback-form') %>

<%- include('../partials/footer') %>
