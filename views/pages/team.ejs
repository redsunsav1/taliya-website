<% var pageTitle = 'Наша команда'; %>
<%- include('../partials/header') %>

<main>
  <%
    const teamData = content.team || { title: '', subtitle: '', members: [] };
    const members = Array.isArray(teamData.members) ? teamData.members : [];
    const sectionNames = Array.isArray(teamData.sections) && teamData.sections.length
      ? teamData.sections
      : Array.from(new Set(members.flatMap(function(member) {
          return Array.isArray(member.sections) && member.sections.length
            ? member.sections
            : [member.section || member.category || 'Специалисты'];
        })));
    const sections = sectionNames.map(function(sectionName) {
      return {
        title: sectionName,
        members: members.filter(function(member) {
          const memberSections = Array.isArray(member.sections) && member.sections.length
            ? member.sections
            : [member.section || member.category || 'Специалисты'];
          return memberSections.includes(sectionName);
        })
      };
    }).filter(function(section) { return section.members.length; });
  %>
  <!-- Герой-баннер -->
  <section class="section section--hero">
    <div class="container">
      <div class="hero-content fade-in">
        <h1 class="section__title"><%= teamData.title || 'Наша команда' %></h1>
        <p class="section__subtitle"><%= teamData.subtitle || 'Опытные специалисты в области косметологии и здоровья' %></p>
      </div>
    </div>
  </section>

  <!-- Сетка специалистов -->
  <% if (sections.length) { %>
    <section class="section section--team">
      <div class="container">
        <% sections.forEach(function(section) { %>
          <div class="team-section-group fade-in">
            <h2 class="section__title team-section-group__title"><%= section.title %></h2>
            <div class="team-grid">
              <% section.members.forEach(function(member) { %>
                <div class="team-card">
                  <% if (member.photo) { %>
                    <div class="team-card__photo">
                      <img src="<%= member.photo %>" alt="<%= member.name %>" loading="lazy">
                    </div>
                  <% } %>
                  <div class="team-card__content">
                    <h3 class="team-card__name"><%= member.name %></h3>
                    <p class="team-card__role"><%= member.role %></p>
                    <% if (member.experience) { %>
                      <p class="team-card__experience">
                        <i class="lucide" data-icon="briefcase"></i>
                        <%= /^\d+$/.test(String(member.experience).trim()) ? ('Опыт работы: ' + member.experience + ' лет') : member.experience %>
                      </p>
                    <% } %>
                    <% if (member.education) { %>
                      <p class="team-card__credential">
                        <i class="lucide" data-icon="graduation-cap"></i>
                        <%= member.education %>
                      </p>
                    <% } %>
                    <% if (member.certificate) { %>
                      <p class="team-card__credential">
                        <i class="lucide" data-icon="badge-check"></i>
                        <%= member.certificate %>
                      </p>
                    <% } %>
                    <% if (member.bio) { %>
                      <p class="team-card__bio"><%= member.bio %></p>
                    <% } %>
                    <% if (member.specialties && Array.isArray(member.specialties)) { %>
                      <div class="team-card__specialties">
                        <% member.specialties.forEach(function(specialty) { %>
                          <span class="specialty-tag"><%= specialty %></span>
                        <% }); %>
                      </div>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>

  <% if (!sections.length) { %>
    <section class="section section--team">
      <div class="container">
        <p class="section__subtitle">Специалисты пока не добавлены.</p>
      </div>
    </section>
  <% } %>

  <!-- Форма обратной связи -->
  <section class="section section--callback">
    <div class="container">
      <%- include('../partials/callback-form') %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
