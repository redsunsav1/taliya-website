<% const pageTitle = service.name %>
<%- include('../partials/header') %>

<%
  /* Determine whether any item has package pricing */
  const hasPackage5  = service.items.some(item => item.pricePackage5  && item.pricePackage5.trim());
  const hasPackage10 = service.items.some(item => item.pricePackage10 && item.pricePackage10.trim());

  /* Other services: exclude current, take first 4 */
  const otherServices = content.services.filter(s => s.slug !== service.slug).slice(0, 4);

  /* Helpers */
  const hasTezisy = service.tezisy && service.tezisy.length;
  const hasMediaGallery = service.mediaGallery && service.mediaGallery.enabled &&
                          ((service.mediaGallery.photos && service.mediaGallery.photos.length) || service.mediaGallery.videoUrl);
  const hasSanpinBanner = service.sanpinBanner && service.sanpinBanner.enabled && service.sanpinBanner.text;
  const hasPersonalProtocol = service.personalProtocol && service.personalProtocol.enabled && service.personalProtocol.text;
  const hasBookingCta = service.bookingCta && service.bookingCta.enabled && service.bookingCta.title;
  const benefitsTitle = service.benefitsTitle || 'Наши преимущества';
  const maxChatUrl = content.site.maxChatUrl || '';
%>

<!-- ===== SERVICE HERO BANNER ===== -->
<section class="service-hero">
  <img
    src="<%= service.image %>"
    alt="<%= service.name %>"
    class="service-hero__bg"
  >
  <div class="service-hero__overlay"></div>

  <div class="service-hero__content container">
    <!-- Breadcrumb -->
    <nav class="service-hero__breadcrumb" aria-label="Breadcrumb">
      <a href="/">Главная</a>
      <i data-lucide="chevron-right" style="width:14px;height:14px;"></i>
      <span>Услуги</span>
      <i data-lucide="chevron-right" style="width:14px;height:14px;"></i>
      <span><%= service.name %></span>
    </nav>

    <!-- Heading -->
    <h1 class="service-hero__title"><%= service.name %></h1>

    <!-- Description -->
    <p class="service-hero__description"><%= service.description %></p>

    <!-- Offer badge (custom text) or fallback discount -->
    <% if (service.offerBadge) { %>
      <span class="service-hero__badge service-hero__badge--offer">
        <i data-lucide="gift" style="width:14px;height:14px;"></i>
        <%= service.offerBadge %>
      </span>
    <% } else if (service.discount) { %>
      <span class="service-hero__badge">
        <i data-lucide="percent" style="width:14px;height:14px;"></i>
        Скидка на первый сеанс: <%= service.discount %>
      </span>
    <% } %>

    <!-- CTA buttons -->
    <div class="service-hero__cta service-hero__cta--stack">
      <a href="<%= content.site.profsalon %>" target="_blank" rel="noopener" class="btn btn--primary btn--lg">
        <i data-lucide="calendar-check"></i>
        Записаться
      </a>
      <%- include('../partials/contact-quick-row', { content: content, maxChatUrl: maxChatUrl }) %>
      <p class="service-hero__cta-note">
        Получите персональную консультацию и программу коррекции фигуры
      </p>
    </div>
  </div>
</section>


<!-- ===== TEZISY BLOCK ===== -->
<% if (hasTezisy) { %>
  <section class="section service-tezisy fade-in">
    <div class="container">
      <div class="tezisy-grid">
        <% service.tezisy.forEach(function(t, i) { %>
          <div class="tezis-card fade-in delay-<%= i + 1 %>">
            <div class="tezis-card__icon">
              <i data-lucide="<%= t.icon || 'check-circle' %>"></i>
            </div>
            <p class="tezis-card__text"><%= t.text %></p>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>


<!-- ===== MEDIA GALLERY (photos / video of the apparatus) ===== -->
<% if (hasMediaGallery) { %>
  <section class="section service-media fade-in">
    <div class="container">
      <% if (service.mediaGallery.title) { %>
        <h2 class="section__title"><%= service.mediaGallery.title %></h2>
      <% } %>

      <% if (service.mediaGallery.videoUrl) { %>
        <div class="service-media__video">
          <div class="video-wrapper">
            <iframe
              src="<%= service.mediaGallery.videoUrl %>"
              allow="autoplay; fullscreen; picture-in-picture; encrypted-media; gyroscope; accelerometer; clipboard-write;"
              frameborder="0"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      <% } %>

      <% if (service.mediaGallery.photos && service.mediaGallery.photos.length) { %>
        <div class="service-media__gallery">
          <% service.mediaGallery.photos.forEach(function(photo, i) { %>
            <div class="service-media__item fade-in delay-<%= i + 1 %>">
              <img src="<%= photo %>" alt="<%= service.mediaGallery.title || service.name %> — фото <%= i + 1 %>" loading="lazy">
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>
<% } %>


<!-- ===== BENEFITS / ADVANTAGES SECTION ===== -->
<% if (service.advantages && service.advantages.length) { %>
  <section class="section service-advantages fade-in">
    <div class="container">
      <h2 class="section__title"><%= benefitsTitle %></h2>
      <% if (!service.benefitsTitle) { %>
        <p class="section__subtitle">Почему клиенты выбирают нас для <%= service.name.toLowerCase() %></p>
      <% } %>

      <div class="service-advantages__grid">
        <% service.advantages.forEach(function(adv, i) { %>
          <div class="advantage-card fade-in delay-<%= i + 1 %>">
            <div class="advantage-card__icon">
              <i data-lucide="<%= adv.icon %>"></i>
            </div>
            <div class="advantage-card__body">
              <h3 class="advantage-card__title"><%= adv.title %></h3>
              <p class="advantage-card__text"><%= adv.text %></p>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>


<!-- ===== DETAILED DESCRIPTION + VIDEO (How it works) ===== -->
<% if (service.detailedDescription || service.videoUrl) { %>
  <section class="section service-details fade-in">
    <div class="container">
      <% if (service.detailedDescription) { %>
        <h2 class="section__title">Как это работает</h2>
        <div class="service-details__text">
          <p><%= service.detailedDescription %></p>
        </div>
      <% } %>

      <% if (service.videoUrl) { %>
        <div class="service-details__video">
          <div class="video-wrapper">
            <iframe
              src="<%= service.videoUrl %>"
              allow="autoplay; fullscreen; picture-in-picture; encrypted-media; gyroscope; accelerometer; clipboard-write;"
              frameborder="0"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      <% } %>
    </div>
  </section>
<% } %>


<!-- ===== PERSONAL PROTOCOL BLOCK ===== -->
<% if (hasPersonalProtocol) { %>
  <section class="section service-protocol fade-in">
    <div class="container">
      <div class="service-protocol__card">
        <div class="service-protocol__icon">
          <i data-lucide="clipboard-list"></i>
        </div>
        <% if (service.personalProtocol.title) { %>
          <h3 class="service-protocol__title"><%= service.personalProtocol.title %></h3>
        <% } %>
        <p class="service-protocol__text"><%= service.personalProtocol.text %></p>
      </div>
    </div>
  </section>
<% } %>


<!-- ===== ANIMATED SANPIN BANNER (before price list) ===== -->
<% if (hasSanpinBanner) { %>
  <section class="service-sanpin-banner">
    <div class="sanpin-marquee">
      <div class="sanpin-marquee__track">
        <% for (let i = 0; i < 4; i++) { %>
          <span class="sanpin-marquee__item">
            <i data-lucide="shield-check"></i>
            <%= service.sanpinBanner.text %>
          </span>
          <span class="sanpin-marquee__sep">✦</span>
        <% } %>
      </div>
    </div>
  </section>
<% } %>


<!-- ===== PRICE LIST SECTION ===== -->
<section class="section service-price" id="price">
  <div class="container">
    <h2 class="section__title">Цены</h2>
    <p class="section__subtitle"><%= service.name %></p>

    <%
      /* Group items by category if categories exist */
      const categories = [];
      const catMap = {};
      service.items.forEach(function(item) {
        const cat = item.category || '';
        if (!catMap[cat]) {
          catMap[cat] = [];
          categories.push(cat);
        }
        catMap[cat].push(item);
      });
      const hasCategories = categories.length > 1 || (categories.length === 1 && categories[0] !== '');
    %>

    <% if (hasCategories) { %>
      <div class="price-accordion">
        <% categories.forEach(function(cat, catIdx) { %>
          <% const isOnlyPriceCategory = categories.length === 1; %>
          <div class="price-accordion__item<%= isOnlyPriceCategory ? ' price-accordion__item--open' : '' %>">
            <button type="button" class="price-accordion__header" onclick="togglePriceAccordion(this)">
              <span class="price-accordion__title"><%= cat || 'Прочее' %></span>
              <span class="price-accordion__count"><%= catMap[cat].length %></span>
              <span class="price-accordion__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </button>
            <div class="price-accordion__body" <% if (!isOnlyPriceCategory) { %>style="display:none;"<% } %>>
              <div class="price-table-wrapper">
                <table class="price-table">
                  <thead>
                    <tr>
                      <th>Услуга</th>
                      <th>Длительность</th>
                      <th>Цена</th>
                      <% if (hasPackage5) { %><th>Абонемент от 5</th><% } %>
                      <% if (hasPackage10) { %><th>Абонемент от 10</th><% } %>
                    </tr>
                  </thead>
                  <tbody>
                    <% catMap[cat].forEach(function(item) { %>
                      <tr>
                        <td>
                          <strong class="service-price__item-name"><%= item.name %></strong>
                          <% if (item.description) { %>
                            <span class="service-price__item-desc"><%= item.description %></span>
                          <% } %>
                        </td>
                        <td><%= item.duration || '—' %></td>
                        <td class="price-cell"><%= item.price %></td>
                        <% if (hasPackage5) { %>
                          <td class="price-cell price-cell--discount">
                            <%= (item.pricePackage5 && item.pricePackage5.trim()) ? item.pricePackage5 : '—' %>
                          </td>
                        <% } %>
                        <% if (hasPackage10) { %>
                          <td class="price-cell price-cell--discount">
                            <%= (item.pricePackage10 && item.pricePackage10.trim()) ? item.pricePackage10 : '—' %>
                          </td>
                        <% } %>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="price-table-wrapper">
        <table class="price-table">
          <thead>
            <tr>
              <th>Услуга</th>
              <th>Длительность</th>
              <th>Цена</th>
              <% if (hasPackage5) { %><th>Абонемент 5</th><% } %>
              <% if (hasPackage10) { %><th>Абонемент 10</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% service.items.forEach(function(item) { %>
              <tr>
                <td>
                  <strong class="service-price__item-name"><%= item.name %></strong>
                  <% if (item.description) { %>
                    <span class="service-price__item-desc"><%= item.description %></span>
                  <% } %>
                </td>
                <td><%= item.duration || '—' %></td>
                <td class="price-cell"><%= item.price %></td>
                <% if (hasPackage5) { %>
                  <td class="price-cell price-cell--discount">
                    <%= (item.pricePackage5 && item.pricePackage5.trim()) ? item.pricePackage5 : '—' %>
                  </td>
                <% } %>
                <% if (hasPackage10) { %>
                  <td class="price-cell price-cell--discount">
                    <%= (item.pricePackage10 && item.pricePackage10.trim()) ? item.pricePackage10 : '—' %>
                  </td>
                <% } %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (service.offerBadge) { %>
      <p class="service-price__note">
        <i data-lucide="gift" style="width:16px;height:16px;vertical-align:middle;"></i>
        <strong><%= service.offerBadge %></strong>
      </p>
    <% } else if (service.discount) { %>
      <p class="service-price__note">
        <i data-lucide="info" style="width:16px;height:16px;vertical-align:middle;"></i>
        Скидка на первый сеанс: <strong><%= service.discount %></strong>
      </p>
    <% } %>

    <p class="med-disclaimer">Имеются противопоказания. Необходима консультация специалиста.</p>
  </div>
</section>


<!-- ===== BOOKING CTA BLOCK (after price) ===== -->
<% if (hasBookingCta) { %>
  <section class="section service-booking-cta fade-in">
    <div class="container">
      <div class="booking-cta">
        <div class="booking-cta__content">
          <h2 class="booking-cta__title"><%= service.bookingCta.title %></h2>
          <% if (service.bookingCta.highlight) { %>
            <div class="booking-cta__highlight"><%= service.bookingCta.highlight %></div>
          <% } %>
          <% if (service.bookingCta.subtitle) { %>
            <p class="booking-cta__subtitle"><%= service.bookingCta.subtitle %></p>
          <% } %>
          <div class="booking-cta__actions">
            <a href="<%= content.site.profsalon %>" target="_blank" rel="noopener" class="btn btn--primary btn--lg">
              <i data-lucide="calendar-check"></i>
              Записаться
            </a>
            <%- include('../partials/contact-quick-row', { content: content, maxChatUrl: maxChatUrl }) %>
          </div>
        </div>
      </div>
    </div>
  </section>
<% } %>


<!-- ===== DOCTORS SECTION ===== -->
<% if (service.doctors && service.doctors.length) { %>
  <section class="section service-doctors fade-in">
    <div class="container">
      <h2 class="section__title">Команда опытных профессионалов</h2>
      <p class="section__subtitle">Опытные профессионалы, которым вы можете доверять</p>

      <div class="service-doctors__grid">
        <% service.doctors.forEach(function(doc, i) { %>
          <div class="doctor-card fade-in delay-<%= i + 1 %>">
            <div class="doctor-card__photo-wrapper">
              <img
                src="<%= doc.photo %>"
                alt="<%= doc.name %>"
                class="doctor-card__photo"
                loading="lazy"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              >
              <div class="doctor-card__placeholder" style="display:none;">
                <i data-lucide="user" style="width:64px;height:64px;color:var(--color-warm-gray);"></i>
              </div>
            </div>
            <h3 class="doctor-card__name"><%= doc.name %></h3>
            <p class="doctor-card__role"><%= doc.role %></p>
            <% if (doc.experience) { %>
              <p class="doctor-card__experience">
                <i data-lucide="award" style="width:14px;height:14px;vertical-align:middle;margin-right:4px;"></i>
                <%= doc.experience %>
              </p>
            <% } %>
            <p class="doctor-card__bio"><%= doc.bio %></p>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>


<!-- ===== CALLBACK FORM ===== -->
<%- include('../partials/callback-form') %>


<!-- ===== OTHER SERVICES SECTION ===== -->
<% if (otherServices.length) { %>
  <section class="section service-others bg-off-white fade-in">
    <div class="container">
      <h2 class="section__title">Другие услуги</h2>
      <p class="section__subtitle">Ознакомьтесь с другими нашими направлениями</p>

      <div class="services__grid">
        <% otherServices.forEach(function(s, i) { %>
          <a href="/service/<%= s.slug %>" class="service-card fade-in delay-<%= i + 1 %>">
            <div class="service-card__image-wrap">
              <img
                src="<%= s.image %>"
                alt="<%= s.name %>"
                class="service-card__image"
                loading="lazy"
              >
            </div>
            <div class="service-card__body">
              <h3 class="service-card__name"><%= s.shortName || s.name %></h3>
              <p class="service-card__brief"><%= s.description || '' %></p>
              <div class="service-card__bottom">
                <span class="service-card__more">Подробнее</span>
                <span class="service-card__arrow">
                  <i data-lucide="arrow-right"></i>
                </span>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>

<%- include('../partials/footer') %>
