<% var pageTitle = 'Акции и предложения'; %>
<%- include('../partials/header') %>

<!-- Page Hero -->
<section class="page-hero">
  <div class="page-hero__inner">
    <span class="eyebrow">Специальные предложения</span>
    <h1 class="page-hero__title"><%= content.promotions && content.promotions.title ? content.promotions.title : 'Акции и предложения' %></h1>
    <p class="page-hero__subtitle"><%= content.promotions && content.promotions.subtitle ? content.promotions.subtitle : 'Выгодные условия для наших гостей' %></p>
  </div>
</section>

<!-- Promotions grid -->
<% var promos = (content.promotions && Array.isArray(content.promotions.items) ? content.promotions.items : []).filter(function(p){ return p.active !== false; }); %>
<% if (promos.length > 0) { %>
<section class="section">
  <div class="container">
    <div class="promotions__list">
      <% promos.forEach(function(promo, i) { %>
        <article class="promotion-card fade-in delay-<%= Math.min(i + 1, 6) %>">
          <% if (promo.badge) { %>
            <span class="promotion-card__badge"><%= typeof promo.badge === 'string' ? promo.badge : (promo.badge.text || '') %></span>
          <% } %>
          <h3 class="promotion-card__title"><%= promo.title %></h3>
          <p class="promotion-card__description"><%= promo.description %></p>
          <% if (Array.isArray(promo.details)) { %>
            <ul style="margin: var(--space-md) 0; display: flex; flex-direction: column; gap: 6px;">
              <% promo.details.forEach(function(d) { %>
                <li style="display: flex; align-items: flex-start; gap: 8px; font-size: var(--font-size-sm); color: var(--color-text-muted);">
                  <i data-lucide="check" style="width: 14px; height: 14px; color: var(--color-sage-deep); margin-top: 4px; flex-shrink: 0;"></i>
                  <span><%= d %></span>
                </li>
              <% }); %>
            </ul>
          <% } %>
          <div style="margin-top: var(--space-lg); display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); flex-wrap: wrap;">
            <a href="<%= promo.link || content.site.profsalon || '#' %>" <%= promo.link && promo.link.indexOf('http') === 0 ? 'target="_blank" rel="noopener"' : '' %> class="btn btn--primary btn--sm">
              <i data-lucide="calendar-check"></i>
              Записаться
            </a>
            <% if (promo.validUntil) { %>
              <span style="font-size: var(--font-size-xs); color: var(--color-text-muted); display: inline-flex; align-items: center; gap: 6px;">
                <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
                По <%= promo.validUntil %>
              </span>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
    <p class="med-disclaimer">Акции предназначены для лиц старше 18 лет. Подробные условия уточняйте у администратора. Имеются противопоказания. Необходима консультация специалиста.</p>
  </div>
</section>
<% } else { %>
<section class="section">
  <div class="container" style="text-align: center;">
    <p style="color: var(--color-text-muted);">В данный момент нет активных акций. Загляните позже!</p>
  </div>
</section>
<% } %>

<%- include('../partials/callback-form') %>
<%- include('../partials/footer') %>
